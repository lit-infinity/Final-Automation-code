package Base;

import java.time.Duration;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;
import org.openqa.selenium.edge.EdgeDriver;
import org.openqa.selenium.edge.EdgeOptions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class base {
	
	//comment below two line for parrallel run
	 public static WebDriver driver;
     public static WebDriverWait wait;
    
  //comment out two line for parrallel run  
//   public  WebDriver driver;
//   public  WebDriverWait wait;




    public void setup() {
    	
    	if (driver != null) {
            System.out.println("Driver already exists — reusing existing browser session");
            return;   // ✅ skip opening a new browser entirely
        }
        String browser = "chrome"; // ✅ Switch between "chrome" or "edge"
//        WebDriver webDriver = null;

        if (browser.equalsIgnoreCase("chrome")) {

            // ✅ Chrome Setup
            ChromeOptions options = new ChromeOptions();
            options.addArguments("--disable-notifications");
            options.addArguments("--disable-popup-blocking");
            driver = new ChromeDriver(options);
//            webDriver = new ChromeDriver(options);
            System.out.println("Chrome browser launched successfully");

        } else if (browser.equalsIgnoreCase("edge")) {

            // ✅ Edge Setup
            EdgeOptions options = new EdgeOptions();
            options.addArguments("--disable-notifications");
            options.addArguments("--disable-popup-blocking");
            driver = new EdgeDriver(options);
//            webDriver = new EdgeDriver(options);
            System.out.println("Edge browser launched successfully");

        } else {
            System.out.println("❌ Invalid browser name! Use 'chrome' or 'edge'");
        }

        driver.manage().window().maximize();
        driver.get("https://vanita.salesmate.io/login/");
        wait = new WebDriverWait(driver, Duration.ofSeconds(10));
        
    }
    

    public void tearDown() {                             // quits browser
        if (driver != null) {
            driver.quit();
            driver = null;
//           comment  below two lines for parralel run
             attachFileFromRecord.AttachFromRecordNavigation.loggedIn = false;
             attachFileFromRecord.AttachFromRecordNavigation.navigated = false;
            System.out.println("Browser closed successfully");
        }
    }
}