package attachFileFromRecord;

import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.testng.Assert;

public class Uploadedbyfilter extends AttachFromRecordNavigation {

	// ---------- Locators ----------

	
	private final By Uploadedbydropdwon  = By.xpath("(//input[@class='select2-search__field'])[2]");
	
	private WebDriverWait getWait() {
		return new WebDriverWait(driver, Duration.ofSeconds(20));
	}
	
	public void dropdwonclick() {
		
		
		WebDriverWait wait = getWait();
		wait.until(ExpectedConditions.visibilityOfElementLocated(Uploadedbydropdwon));
		driver.findElement(Uploadedbydropdwon).click();
		System.out.println("dropdown is clicked");
	}


}
